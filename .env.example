# HoloMe avatar SDK key — ask the platform team for the current value.
# Prefer HOLOME_SDK_KEY in Docker/production (read at runtime).
# NEXT_PUBLIC_HOLOME_SDK_KEY still works for local `next dev`.
HOLOME_SDK_KEY=
NEXT_PUBLIC_HOLOME_SDK_KEY=

# The avatar runtime bundle and the window global it registers are supplied by
# our realism partner and are deployment configuration, not source constants.
# Both are required for the digital human to appear — ask the platform team for
# the current values.
NEXT_PUBLIC_HOLOME_SDK_URL=
NEXT_PUBLIC_HOLOME_RUNTIME_GLOBAL=
PORT=8081

# --- L'Oréal Beauty Coach (Phase 1) ---
# Claude API key for the governed conversation engine. Without it the coach
# runs on the deterministic pack-grounded fallback (works offline for demos).
ANTHROPIC_API_KEY=
# Optional model override (default: claude-opus-5)
COACH_MODEL=
# HMAC secret for the advisor session cookie. Set a long random value in prod.
COACH_SESSION_SECRET=
# SQLite database file (default: ./data/coach.db)
COACH_DB_PATH=

# --- Speech-to-text (Whisper) ---
# The coach hears advisors through Whisper with the session language pinned.
# Hosted OpenAI Whisper:
#   WHISPER_API_KEY=sk-...
# Or a self-hosted / in-VPC Whisper-compatible endpoint (preferred for markets
# where advisor voice data cannot leave the client network):
#   WHISPER_API_URL=https://whisper.internal/v1/audio/transcriptions
#   WHISPER_MODEL=whisper-1
